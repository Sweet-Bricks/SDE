add_project_arguments(
    # clang-cl: C++26 (__cplusplus 202400L)
    '/std:c++26preview',

    # Compat groups flag modern C++ itself
    '-Wno-c++98-compat',
    '-Wno-c++98-compat-pedantic',
    '-Wno-pre-c++14-compat',
    '-Wno-pre-c++17-compat',
    '-Wno-pre-c++20-compat',
    '-Wno-pre-c++20-compat-pedantic',
    '-Wno-pre-c++23-compat',
    '-Wno-pre-c++26-compat',

    language: 'cpp',
)
